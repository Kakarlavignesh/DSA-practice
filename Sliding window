variable sliding window..

import java.util.*;
class Main {
    public static void main(String[] args) {
        int[] arr={0,1,3,1,1,6,7,1,0,1};
        int n=arr.length;
        int l=0;
        int count=0;
        int max=0;
        for(int r=0;r<n;r++){
            if(arr[r]==1){
                count++;
            }
            while(count>2){
                if(arr[l]==1){
                    count--;
                }
                l++;
            }
            max=Math.max(max,r-l+1);
        }
        System.out.print(max);
    }
}

