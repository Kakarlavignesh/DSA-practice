Highest sum of 3 window..

import java.util.*;
class Main {
    public static void main(String[] args) {
        int[] arr={3,4,5,2,1};
        int n=arr.length;
        int l=0;
        int ans=0;
        int sl=3;
        int max=Integer.MIN_VALUE;
        for(int i=0;i<n;i++){
            ans+=arr[i];
            if(i-l==sl){
                ans-=arr[l];
                l++;
            }
            if(i-l+1==sl){
                max=Math.max(max,ans);
            }
        }
        System.out.println(max);
    }
}

Highest sum of 3 window..(2nd model)..

import java.util.*;
class Main {
    public static void main(String[] args) {
        int[] arr={3,4,5,2,1};
        int n=arr.length;
        int l=0;
        int ans=0;
        int k=3;
        for(int i=0;i<k;i++){
            ans+=arr[i];
        }
        int max=ans;
        for(int i=k;i<n;i++){
            ans=ans+arr[i]-arr[i-k];
            max=Math.max(ans,max);
        }
        System.out.println(max);
    }
}

1876 leetcode..

class Solution {
    public int countGoodSubstrings(String s) {
        int n=s.length();
        HashMap <Character,Integer> hm=new HashMap<>();
        int ans=0;
        int l=0;
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            hm.put(ch,hm.getOrDefault(ch,0)+1);
            // int ans=0;
            if(i-l==3){
                char tch=s.charAt(l);
                hm.put(tch,hm.get(tch)-1);
                if(hm.get(tch)==0){
                    hm.remove(tch);
                }
                l++;
            }
            if(hm.size()==3){
                ans++;
            }
        }
        return ans;
    }
}


