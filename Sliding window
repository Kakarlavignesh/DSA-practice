Substrings of an String..

import java.util.*;
class Main {
    public static void main(String[] args) {
        String s="Vignesh";
        int n=s.length();
        ArrayList<String> ans=new ArrayList<>();
        for(int i=0;i<n;i++){
            for(int j=i;j<n;j++){
                String temp=s.substring(i,j+1);
                ans.add(temp);
            }
        }
        System.out.println(ans);
    }
}
