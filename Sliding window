leetcode 1004..

class Solution {
    public int longestOnes(int[] nums, int k) {
        int n=nums.length;
        int l=0;
        int count=0;
        int max=0;
        int count0=0;
        for(int r=0;r<n;r++){
            if(nums[r]==1){
                count++;
            }
            if(nums[r]==0){
                count0++;
            }
            while(count0>k){
                if(nums[l]==0){
                    count0--;
                }
                l++;
            }
            max=Math.max(max,r-l+1);
        }
        return max;
    }
}
